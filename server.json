{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.allswapio/mcp-server",
  "title": "AllSwap",
  "description": "Read-only tools: AllSwap's public asset catalog, its official channels, and block-explorer links.",
  "version": "1.0.2",
  "websiteUrl": "https://allswap.io/docs/mcp",
  "repository": {
    "url": "https://github.com/allswapio/mcp-server",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://allswap.io/brand/media-kit/logo-512x512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@allswapio/mcp-server",
      "version": "1.0.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
